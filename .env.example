# Settings for your app. Copy this file to `.env` and change what you need:
#
#     cp .env.example .env
#
# `.env` is never committed — it is in `.gitignore` — so nothing here ends up
# on GitHub. Every line has a sensible answer already, and an app you run on
# your own machine works with the file exactly as it is.
#
# The server reads this once when it starts. If something is missing or does
# not make sense it stops immediately and tells you which line, rather than
# failing later in front of somebody.


# --- The basics -------------------------------------------------------------

# What your app is called. It appears in e-mails you send.
APP_NAME=InHouse

# Where people open your app in their browser.
# On your own machine that is Vite's address; on your server it is your domain.
APP_URL=http://localhost:5173

# Which port the server listens on. Leave this alone unless something else on
# the machine already uses 3000.
PORT=3000

# `development` while you build, `production` on your server.
NODE_ENV=development


# --- Where things are kept --------------------------------------------------

# The folder that holds everything the app writes: the database (when you have
# not set DATABASE_URL), uploaded files, and the development mail outbox. On
# your server this is a Docker volume, which is what the backup copies.
DATA_DIR=data/dev

# The PostgreSQL database. Leave this out entirely and the app runs a database
# inside itself, stored under DATA_DIR — which is why a fresh clone works with
# nothing installed. On your server, Docker Compose fills this in.
# DATABASE_URL=postgres://inhouse:password@localhost:5432/inhouse

# Where the nightly backups land. If you set it, the health page warns you
# when the newest backup is more than a day and a half old. On your server
# Docker Compose sets it for you (see BACKUP_HOST_DIR at the bottom).
# BACKUP_DIR=/var/backups/inhouse


# --- Signing in -------------------------------------------------------------

# The secret that signs session cookies. Required on your server; on your own
# machine the app makes one for you and keeps it in DATA_DIR/auth-secret.
# Generate one with:  openssl rand -base64 32
# BETTER_AUTH_SECRET=

# Development only, and a big shortcut: with this set, anyone reaching the app
# is treated as this person without signing in. It is how the screenshot
# script works. The server refuses to start with this set and NODE_ENV
# production, so it cannot follow you to your server by accident.
# DEV_AUTO_SIGN_IN_EMAIL=owner@example.com


# --- Sending e-mail ---------------------------------------------------------

# Sign-in links and reminders go out through Resend (resend.com — one API key,
# three thousand messages a month free). Without a key, messages are written
# to DATA_DIR/outbox/ as files instead and the app tells you the path, so you
# can build the whole thing before opening an account.
# RESEND_API_KEY=

# Who your messages come from. Resend will only send from a domain you have
# verified with it — the publishing guide has the DNS records.
EMAIL_FROM=InHouse <no-reply@localhost>


# --- Where your people are --------------------------------------------------

# The app has one time zone and one language. Dates, "today", and the time a
# daily job runs all mean this zone — not the server's, and not the reader's.
# Use a name from the standard list, like Europe/Berlin or America/New_York.
APP_TIME_ZONE=UTC

# How numbers and dates are written, e.g. en-US, en-GB, de-DE.
APP_LOCALE=en-US


# --- Running on a server ----------------------------------------------------

# Which version is running. The release command fills this in with the commit
# it deployed, and the health page shows it back to you.
APP_RELEASE=dev

# Set to `off` on a machine that should only answer requests and never run
# background work. Leave it alone unless you are running more than one server.
WORKER=on


# --- Server only — filled in by deploy/server-setup.sh ---------------------

# None of these is needed for `pnpm dev`. They are here so that when Docker
# Compose stops and names one of them, the line it names exists. On your server
# deploy/server-setup.sh writes all four into /opt/<app>/.env; you never type
# them. To try the containers on your own machine with `docker compose up`,
# uncomment the first two and give the password any value.

# The database's own password. Once the database exists, changing this line
# alone locks the app out of it.
# POSTGRES_PASSWORD=

# The domain Caddy asks Let's Encrypt for a certificate for.
# APP_DOMAIN=localhost

# The server's short name: lowercase, no spaces. It prefixes every container
# and volume, so it must never change on a server that holds data.
# APP_SLUG=inhouse

# The folder on the server the nightly dumps are written to. The app container
# sees it, read-only, as BACKUP_DIR.
# BACKUP_HOST_DIR=/var/backups/inhouse
