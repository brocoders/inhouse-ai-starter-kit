{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(node scripts/*)",
      "Bash(node --test*)",
      "Bash(node server/src/*)",
      "Bash(node --run *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr *)",
      "Bash(pnpm release *)",
      "Bash(pnpm run release *)",
      "Bash(pnpm exec node deploy/*)",
      "Bash(node --run release*)",
      "Bash(node deploy/*)",
      "Bash(node ./deploy/*)",
      "Bash(ssh *)",
      "Edit(/deploy/**)",
      "Edit(/compose.yaml)",
      "Edit(/Caddyfile)",
      "Edit(/Dockerfile)",
      "Edit(/.claude/settings.json)",
      "Edit(/frontend/src/components/ui/**)",
      "Edit(/server/drizzle/*.sql)",
      "Edit(/pnpm-lock.yaml)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./data/**)",
      "Bash(sudo *)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(!.env.example)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": ["docker *", "ssh *"],
    "filesystem": {
      "denyRead": ["~/.ssh", "~/.aws", "~/.config/inhouse"]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "*.npmjs.org",
        "nodejs.org",
        "api.anthropic.com",
        "resend.com",
        "api.resend.com",
        "ui.shadcn.com",
        "cdn.playwright.dev",
        "playwright.download.prss.microsoft.com"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-files.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-commands.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/format.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/on-stop.mjs\"",
            "timeout": 90
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
